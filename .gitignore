# Dependencies / build products
/_old/
**/node_modules/
**/vendor/
**/dist/
**/build/
**/coverage/
**/test-results/
**/playwright-report/
**/.pnpm-store/
**/.phpunit.cache/
**/.cache/
**/.vite/
/.next/
/.nuxt/

# Laravel / local state
**/.phpunit.result.cache
**/bootstrap/cache/*.php
**/storage/logs/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/database/*.sqlite
**/public/storage

# Sensitive configuration (keep documented examples)
**/.env
**/.env.*
!**/.env.example
!**/.env.testing.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
*.recovery
*.secret

# Local development artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
*.tmp
*.swp

# R2-03 Laravel backend local state
/apps/api/vendor/
/apps/api/.env
/apps/api/.env.*
!/apps/api/.env.example
/apps/api/bootstrap/cache/*.php
/apps/api/storage/logs/*
/apps/api/storage/framework/cache/*
/apps/api/storage/framework/sessions/*
/apps/api/storage/framework/views/*
/apps/api/database/*.sqlite

!/apps/api/bootstrap/cache/.gitkeep
!/apps/api/storage/logs/.gitkeep
!/apps/api/storage/framework/sessions/.gitkeep
!/apps/api/storage/framework/views/.gitkeep
!/apps/api/storage/framework/cache/data/.gitkeep
