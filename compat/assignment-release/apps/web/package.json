{
  "name": "@photobunker/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "localization:check": "node scripts/check-localization.mjs",
    "check": "npm run localization:check && npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "canonicalize": "2.1.0",
    "libsodium-wrappers": "0.8.4",
    "livekit-client": "2.22.4",
    "matrix-js-sdk": "44.0.0",
    "piexifjs": "1.0.6",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "6.0.2",
    "@vue/test-utils": "2.5.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.13"
  }
}
