APP_NAME=PhotoBunker
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
LOCAL_SERVER_PROTOTYPE_ENABLED=true
# Identity works in production when enabled. APP_URL is trusted automatically;
# list only additional exact browser origins here, separated by commas.
IDENTITY_ENABLED=true
IDENTITY_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=photobunker
DB_USERNAME=photobunker
# Populated by the local setup script; never commit credentials.
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_LIFETIME=30
SESSION_SAME_SITE=strict

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=s3

# Local Garage credentials are generated by the repository setup script.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage
AWS_BUCKET=photobunker
AWS_ENDPOINT=http://garage:3900
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BROWSER_ENDPOINT=http://localhost:3900
AWS_CORS_ALLOWED_ORIGINS=http://localhost:5173
