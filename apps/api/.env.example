APP_NAME=PhotoBunker
APP_ENV=local
APP_DEBUG=false
APP_URL=https://localhost
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=photobunker
DB_USERNAME=photobunker
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
LOG_CHANNEL=stderr

QUEUE_CONNECTION=database
PHOTO_S3_ENDPOINT=http://garage:3900
PHOTO_S3_REGION=garage
PHOTO_S3_BUCKET=photobunker-new
PHOTO_S3_ACCESS_KEY=
PHOTO_S3_SECRET_KEY=
PHOTO_ACCOUNT_QUOTA_BYTES=1073741824

# Staging/local two-account E2EE acceptance only; production always denies recipient reads.
PHOTO_RECIPIENT_THUMBNAIL_PREVIEW=false
