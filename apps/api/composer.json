{
  "name": "photobunker/identity-api",
  "description": "PhotoBunker anonymous Identity backend, isolated from photo/Matrix services",
  "type": "project",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "nunomaduro/collision": "^9.0"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"],
    "test": "@php artisan test"
  },
  "config": {"sort-packages": true, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
